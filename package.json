{
  "name": "programmable-card-server",
  "version": "1.0.0",
  "description": "HTTP server that runs Investec programmable card code in the card code emulator",
  "main": "dist/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "npm run dev:tsc & npm run dev:node",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:node": "node --env-file-if-exists=.env --enable-source-maps --watch dist/index.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "clean": "rimraf dist/",
    "build": "npm run clean && tsc"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "morgan": "^1.12.1",
    "programmable-card-code-emulator": "^3.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.5",
    "rimraf": "^6.1.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
